{
  "name": "lol-tft",
  "version": "2.7.1",
  "private": true,
  "type": "module",
  "description": "英雄联盟国服战绩查询（WeGame 页面注入版）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --mode lib",
    "build:app": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:userscript": "npm run build && node scripts/build-userscript.mjs",
    "build:all": "npm run build:userscript && npm run build:app"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mscststs/lol-tft.git"
  },
  "license": "ISC",
  "keywords": [
    "lol",
    "league-of-legends",
    "wegame",
    "userscript",
    "vue3",
    "vite"
  ],
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
