{
  "name": "lol-record-helper",
  "version": "2.14.0",
  "private": true,
  "type": "module",
  "description": "LOL 战绩助手：英雄联盟国服战绩查询与官方助手增强（WeGame 页面注入版）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --mode lib",
    "build:app": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:userscript": "npm run build && node scripts/build-userscript.mjs",
    "build:all": "npm run typecheck && vite build --mode lib && node scripts/build-userscript.mjs && vite build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entyr233/lol-record-helper.git"
  },
  "license": "ISC",
  "homepage": "https://github.com/entyr233/lol-record-helper",
  "bugs": {
    "url": "https://github.com/entyr233/lol-record-helper/issues"
  },
  "keywords": [
    "lol",
    "league-of-legends",
    "wegame",
    "userscript",
    "vue3",
    "vite"
  ],
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
